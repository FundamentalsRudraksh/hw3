calculate_pagerank <- function(P, beta) {
N <- nrow(P)
J <- matrix(1/N, nrow = N, ncol = N)
G <- beta * P + (1 - beta) * J
e <- eigen(t(G))
v <- Re(e$vectors[,1])
pageranks <- v / sum(v)
return(pageranks)}
