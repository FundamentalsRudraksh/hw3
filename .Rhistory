P <- matrix(c(0.5, 0.5, 0,
0.5, 0,   0.5,
1/3, 1/3, 1/3),
nrow = 3, byrow = TRUE)
print(P)
calculate_pagerank <- function(P, beta) {
N <- nrow(P)
J <- matrix(1/N, nrow = N, ncol = N)
G <- beta * P + (1 - beta) * J
e <- eigen(t(G))
v <- Re(e$vectors[,1])
pageranks <- v / sum(v)
return(pageranks)}
# Case1 when Beta = 1
pr_beta_1 <- calculate_pagerank(P, 1)
print("PageRanks for Beta = 1:")
print(pr_beta_1)
# Case2 when Beta = 0.85
