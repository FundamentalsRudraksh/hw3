# This is my function to find pagerank
calculate_pagerank <- function(P, beta) {
N <- nrow(P)
J <- matrix(1/N, nrow = N, ncol = N)
G <- beta * P + (1 - beta) * J
pi <- rep(1/N, N)
for(i in 1:1000) {
prev_pi <- pi
pi <- pi %*% G}
return(as.vector(pi))
}
# Case1 when Beta = 1
pr_beta_1 <- calculate_pagerank(P, 1)
print("PageRanks for Beta = 1:")
print(pr_beta_1)
# Case2 when Beta = 0.85
